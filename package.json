{
  "name": "tryferos-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "next typegen && tsc --noEmit && tsc -p verification",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "unused": "knip",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm unused"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@shadcn/react": "^0.3.1",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.74.0",
    "motion": "^14.13.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.24.0",
    "recharts": "3.8.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.93.0",
    "@shadcn/lint": "^0.2.5",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-project-structure": "^3.14.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "knip": "^6.45.1",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,yaml,yml,css}": "prettier --write"
  }
}
